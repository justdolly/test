// ANIMEX — Prisma Schema
// DB: PostgreSQL | Engine: Prisma 5+

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ───────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  username        String    @unique
  avatarUrl       String?
  role            UserRole  @default(USER)
  isVerified      Boolean   @default(false)
  verifyToken     String?   @unique
  verifyExpiresAt DateTime?
  resetToken      String?   @unique
  resetExpiresAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  watchProgress WatchProgress[]
  bookmarks     Bookmark[]
  sessions      Session[]

  @@index([email])
  @@index([verifyToken])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique  // store hash of JWT jti, not raw token
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

// ─── ANIME ───────────────────────────────────────────

model Anime {
  id            String      @id @default(cuid())
  anilistId     Int?        @unique
  malId         Int?        @unique
  slug          String      @unique
  title         Json        // { romaji, english, native }
  synopsis      String?     @db.Text
  coverImage    String?
  bannerImage   String?
  genres        String[]
  tags          String[]
  status        AnimeStatus @default(ONGOING)
  type          AnimeType   @default(TV)
  season        String?     // "FALL 2024"
  year          Int?
  rating        Float?      // 0-10
  popularity    Int?
  totalEpisodes Int?
  isAdult       Boolean     @default(false)
  studios       String[]
  source        String?     // "MANGA", "ORIGINAL", etc.
  trailer       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastCrawledAt DateTime?

  episodes      Episode[]
  bookmarks     Bookmark[]
  watchProgress WatchProgress[]

  @@index([slug])
  @@index([status])
  @@index([year, season])
  @@map("anime")
}

enum AnimeStatus {
  ONGOING
  COMPLETED
  UPCOMING
  HIATUS
  CANCELLED
}

enum AnimeType {
  TV
  MOVIE
  OVA
  ONA
  SPECIAL
  MUSIC
}

// ─── EPISODES ────────────────────────────────────────

model Episode {
  id          String   @id @default(cuid())
  animeId     String
  number      Float    // Float allows ep 5.5, specials
  title       String?
  synopsis    String?  @db.Text
  thumbnail   String?
  duration    Int?     // seconds
  airDate     DateTime?
  isFiller    Boolean  @default(false)
  isRecap     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  anime         Anime           @relation(fields: [animeId], references: [id], onDelete: Cascade)
  mirrors       EpisodeMirror[]
  watchProgress WatchProgress[]

  @@unique([animeId, number])
  @@index([animeId])
  @@map("episodes")
}

// ─── MIRRORS ─────────────────────────────────────────

model EpisodeMirror {
  id           String       @id @default(cuid())
  episodeId    String
  provider     String       // "vidcloud", "filemoon", "streamtape"
  quality      String       // "1080p", "720p", "auto"
  type         MirrorType   @default(SUB)
  priority     Int          @default(50)   // lower = higher priority
  encryptedUrl String       // NEVER store raw URLs; store encrypted
  healthStatus MirrorHealth @default(UNKNOWN)
  lastChecked  DateTime?
  failCount    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId, priority])
  @@index([healthStatus])
  @@map("episode_mirrors")
}

enum MirrorType {
  SUB
  DUB
  RAW
}

enum MirrorHealth {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

// ─── WATCH PROGRESS ──────────────────────────────────
// High-write table — batched via Redis buffer, NOT direct writes

model WatchProgress {
  id           String   @id @default(cuid())
  userId       String
  animeId      String
  episodeId    String
  position     Int      // seconds watched
  duration     Int      // total episode seconds
  completed    Boolean  @default(false)
  updatedAt    DateTime @updatedAt  // used for dedup/merge logic

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime   Anime   @relation(fields: [animeId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])   // upsert key
  @@index([userId, animeId])
  @@index([userId, updatedAt])
  @@map("watch_progress")
}

// ─── BOOKMARKS ───────────────────────────────────────

model Bookmark {
  id        String       @id @default(cuid())
  userId    String
  animeId   String
  status    WatchStatus  @default(PLAN_TO_WATCH)
  score     Int?         // user rating 1-10
  notes     String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId, status])
  @@map("bookmarks")
}

enum WatchStatus {
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
  PLAN_TO_WATCH
}

// ─── CRAWLER METADATA ────────────────────────────────

model CrawlJob {
  id          String    @id @default(cuid())
  source      String    // "anilist", "mal", "gogoanime"
  targetId    String    // external ID
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([status, scheduledAt])
  @@map("crawl_jobs")
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}
